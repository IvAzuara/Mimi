          duration: duration,
          easing: 'ease-in-out'
        });
        
        anim.onfinish = () => f.remove();
      };

      // Sparkle Particle burst on click (optimized loop count)
      const createSparkles = (x, y) => {
        const container = document.getElementById('particles-container');
        if (!container) return;

        const colors = [
          '#ffffff', 
          '#faf6ec', 
          '#ffe4e1', 
          '#fffacd', 
          'rgba(255, 255, 255, 0.4)'
        ];

        for (let i = 0; i < 18; i++) {
          const sparkle = document.createElement('div');
          sparkle.className = 'sparkle';

          const size = Math.random() * 8 + 4;
          const color = colors[Math.floor(Math.random() * colors.length)];
          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * 160 + 80;

          sparkle.style.position = 'absolute';
          sparkle.style.width = `${size}px`;
          sparkle.style.height = `${size}px`;
          sparkle.style.backgroundColor = color;
          sparkle.style.borderRadius = '50%';
          sparkle.style.left = `${x}px`;
          sparkle.style.top = `${y}px`;
          sparkle.style.boxShadow = `0 0 ${size * 1.5}px ${color}`;
          sparkle.style.pointerEvents = 'none';
          sparkle.style.willChange = 'transform, opacity';

          const tx = Math.cos(angle) * distance;
          const ty = Math.sin(angle) * distance;
          const rot = Math.random() * 360;

          const animation = sparkle.animate([
            { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
            { transform: `translate(calc(-50% + ${tx}px), calc(-50% + ${ty}px)) scale(0) rotate(${rot}deg)`, opacity: 0 }
          ], {
            duration: 1200 + Math.random() * 500,
            easing: 'cubic-bezier(0.1, 0.8, 0.3, 1)',
            fill: 'forwards'
          });

          container.appendChild(sparkle);
          animation.onfinish = () => sparkle.remove();
        }
      };

      const startEcosystem = () => {
        stopEcosystem();
        
        // Spawn initial particles at random heights immediately
        for (let i = 0; i < 7; i++) {
          createSeedAtHeight();
        }
        for (let i = 0; i < 6; i++) {
          createFireflyAtHeight();
        }

        // Set intervals for continuous drift
        backgroundIntervals.push(setInterval(createSeed, 650));
        backgroundIntervals.push(setInterval(createFirefly, 450));
      };

      const stopEcosystem = () => {
        backgroundIntervals.forEach(clearInterval);
        backgroundIntervals = [];
      };

      // Set up click events
      document.addEventListener('DOMContentLoaded', () => {
        const flowerContainer = document.getElementById('flower-interactive');
        const messageCard = document.getElementById('love-message-card');
        const hintText = document.getElementById('hint');
        
        // Select all flower groups to activate opening animations
        const flowerGroups = document.querySelectorAll('.flower-group');

        if (flowerContainer && messageCard) {
          flowerContainer.addEventListener('click', (event) => {
            // Toggle open state on the main interactive container
            const isOpen = flowerContainer.classList.toggle('open');

            // Propagate the open class to each individual flower group
            flowerGroups.forEach(group => {
              group.classList.toggle('open', isOpen);
            });

            // Hide/Show visual hint text
            if (hintText) {
              if (isOpen) {
                hintText.style.opacity = '0';
              } else {
                hintText.style.opacity = '1';
              }
            }

            // Trigger background forest particles and local bursts
            if (isOpen) {
              startEcosystem();
              
              // Fire local particles from click coordinate
              const clickX = event.clientX;
              const clickY = event.clientY;
              createSparkles(clickX, clickY);
            } else {
              stopEcosystem();
            }
          });
        }
      });
    </script>
  </body>
</html>
