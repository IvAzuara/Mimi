---
/**
 * Mimi - Tres Gerberas Blancas en un Jardín Místico
 * Astro Page - Ecosistema orgánico con balanceo al viento y brote escalonado.
 * Modifica la variable 'message' para cambiar el mensaje secreto del centro.
 */

// Mensaje secreto y romántico con la justificación del halago
const message = "Me pediste que te dijera lo bonita que eres... y me quedé pensando. Decirte 'bonita' se siente como decir muy poco para alguien que se ha vuelto indispensable en mi vida, alguien por quien daría cualquier cosa con tal de verte sonreír.";

// Helper para calcular ángulos simétricos en el rango (-180, 180]
function getSymmetricAngle(i, total, offset = 0) {
  let angle = i * (360 / total) + offset;
  while (angle > 180) angle -= 360;
  while (angle <= -180) angle += 360;
  return angle;
}

// Helper para determinar los parámetros del estado cerrado (Phase 1)
function getClosedParams(angle, targetScale, isSepal = false) {
  const threshold = 40;
  const isNearTop = Math.abs(angle) <= threshold;

  if (isNearTop) {
    return {
      rotate: angle * 0.15,
      scaleX: targetScale * (isSepal ? 0.22 : 0.12),
      scaleY: targetScale * (isSepal ? 0.40 : 0.46),
      opacity: isSepal ? 1.0 : 0.8
    };
  } else {
    return {
      rotate: angle,
      scaleX: 0,
      scaleY: 0,
      opacity: 0
    };
  }
}

// =========================================================
// GENERACIÓN DE PÉTALOS - FLOR CENTRAL (Densidad Completa)
// =========================================================
const mainOuterPetals = Array.from({ length: 36 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 36) + (Math.random() - 0.5) * 1.5;
  const scale = 0.98 + Math.random() * 0.04;
  const opacity = 0.95 + Math.random() * 0.05;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const mainMiddlePetals = Array.from({ length: 30 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 30, 6) + (Math.random() - 0.5) * 1.8;
  const scale = 0.82 + Math.random() * 0.04;
  const opacity = 0.94 + Math.random() * 0.06;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const mainInnerPetals = Array.from({ length: 24 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 24, 3) + (Math.random() - 0.5) * 2.0;
  const scale = 0.68 + Math.random() * 0.03;
  const opacity = 0.92 + Math.random() * 0.06;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const mainMiniPetals = Array.from({ length: 36 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 36, 5) + (Math.random() - 0.5) * 2.2;
  const scale = 0.50 + Math.random() * 0.03;
  const opacity = 0.90 + Math.random() * 0.08;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const mainDiscRingPetals = Array.from({ length: 48 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 48) + (Math.random() - 0.5) * 2.5;
  const scale = 0.34 + Math.random() * 0.02;
  const opacity = 0.85 + Math.random() * 0.10;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const mainSepals = Array.from({ length: 24 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 24) + (Math.random() - 0.5) * 1.2;
  const scale = 1.0 + Math.random() * 0.05;
  const closed = getClosedParams(rotate, scale, true);
  return { rotate, scale, closed };
});

// =========================================================
// GENERACIÓN DE PÉTALOS - FLORES LATERALES (Optimizadas para GPU)
// =========================================================
const sideOuterPetals = Array.from({ length: 24 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 24) + (Math.random() - 0.5) * 1.5;
  const scale = 0.98 + Math.random() * 0.04;
  const opacity = 0.95 + Math.random() * 0.05;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const sideMiddlePetals = Array.from({ length: 20 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 20, 9) + (Math.random() - 0.5) * 1.8;
  const scale = 0.82 + Math.random() * 0.04;
  const opacity = 0.94 + Math.random() * 0.06;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const sideInnerPetals = Array.from({ length: 16 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 16, 5) + (Math.random() - 0.5) * 2.0;
  const scale = 0.68 + Math.random() * 0.03;
  const opacity = 0.92 + Math.random() * 0.06;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const sideMiniPetals = Array.from({ length: 24 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 24, 7) + (Math.random() - 0.5) * 2.2;
  const scale = 0.50 + Math.random() * 0.03;
  const opacity = 0.90 + Math.random() * 0.08;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const sideDiscRingPetals = Array.from({ length: 30 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 30) + (Math.random() - 0.5) * 2.5;
  const scale = 0.34 + Math.random() * 0.02;
  const opacity = 0.85 + Math.random() * 0.10;
  const closed = getClosedParams(rotate, scale, false);
  return { rotate, scale, opacity, closed };
});

const sideSepals = Array.from({ length: 16 }, (_, i) => {
  const rotate = getSymmetricAngle(i, 16) + (Math.random() - 0.5) * 1.2;
  const scale = 1.0 + Math.random() * 0.05;
  const closed = getClosedParams(rotate, scale, true);
  return { rotate, scale, closed };
});
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mimi // Un Jardín de Gerberas para Ti</title>
    <meta name="description" content="Una experiencia interactiva con un jardín místico de gerberas blancas que reaccionan al viento." />
    
    <!-- Google Fonts: Playfair Display (Romantic Serif) & Outfit (Modern Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400&family=Playfair+Display:ital,wght=1,400;1,600&display=swap" rel="stylesheet" />
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Outfit', 'sans-serif'],
              display: ['Playfair Display', 'serif'],
            }
          }
        }
      }
    </script>

    <!-- Scoped Interactive Animations -->
    <style>
      /* -------------------------------------------------------------
         0. COMPOSICIÓN Y HARDWARE ACCELERATION (GPU)
         ------------------------------------------------------------- */
      .flower-group,
      .flower-head-wrapper,
      .flower-head-inner,
      .petal,
      .sepal,
      .stem,
      .grass,
      .leaf path {
        will-change: transform, opacity;
      }

      /* -------------------------------------------------------------
         1. CRECIMIENTO DEL TALLO Y HIERBAS SILUETAS
         ------------------------------------------------------------- */
      .stem {
        stroke-dasharray: 550;
        stroke-dashoffset: 550;
      }

      .stem-center { transition: stroke-dashoffset 2.2s cubic-bezier(0.25, 1, 0.5, 1) 0.2s; }
      .stem-left { transition: stroke-dashoffset 2.2s cubic-bezier(0.25, 1, 0.5, 1) 0.6s; }
      .stem-right { transition: stroke-dashoffset 2.2s cubic-bezier(0.25, 1, 0.5, 1) 0.9s; }

      .open .stem {
        stroke-dashoffset: 0;
      }

      .grass {
        fill: url(#grass-grad);
        transform-origin: 400px 800px;
        transform: scaleY(0);
        transition: transform 2.5s cubic-bezier(0.25, 1, 0.5, 1) 0.5s;
        opacity: 0.75;
      }

      .open .grass {
        transform: scaleY(1);
      }

      /* -------------------------------------------------------------
         2. GRUPOS DE FLORES (Movimiento Orgánico de Balanceo)
         ------------------------------------------------------------- */
      .flower-group {
        transform-origin: 400px 800px;
        transition: transform 0.5s ease-out;
      }

      .center-group { transform-origin: 390px 800px; }
      .left-group { transform-origin: 360px 800px; }
      .right-group { transform-origin: 440px 800px; }

      .open.center-group { animation: group-sway-center 8s ease-in-out infinite 2.2s; }
      .open.left-group { animation: group-sway-left 9s ease-in-out infinite 2.6s; }
      .open.right-group { animation: group-sway-right 7.5s ease-in-out infinite 2.9s; }

      /* -------------------------------------------------------------
         3. ELEVACIÓN DE LOS CAPULLOS (Flower Head Wrappers)
         ------------------------------------------------------------- */
      .flower-head-wrapper {
        transform-origin: 0px 0px; 
        transition: transform 2.2s cubic-bezier(0.25, 1, 0.5, 1);
      }

      .flower-head-wrapper.center-flower {
        transform: translate(390px, 800px) scale(0.15);
        transition-delay: 0.2s;
      }
      .open .flower-head-wrapper.center-flower {
        transform: translate(400px, 300px) scale(1);
        animation: head-nod-center 8s ease-in-out infinite 2.2s;
      }

      .flower-head-wrapper.left-flower {
        transform: translate(360px, 800px) scale(0.1);
        transition-delay: 0.6s;
      }
      .open .flower-head-wrapper.left-flower {
        transform: translate(250px, 420px) scale(0.75) rotate(-25deg);
        animation: head-nod-left 9s ease-in-out infinite 2.6s;
      }

      .flower-head-wrapper.right-flower {
        transform: translate(440px, 800px) scale(0.1);
        transition-delay: 0.9s;
      }
      .open .flower-head-wrapper.right-flower {
        transform: translate(550px, 450px) scale(0.7) rotate(20deg);
        animation: head-nod-right 7.5s ease-in-out infinite 2.9s;
      }

      /* Hover & Click Elastic Wobble */
      .flower-container:hover .open.flower-head-wrapper.center-flower {
        transform: translate(400px, 300px) scale(1.03) rotate(2.5deg);
        animation: none;
      }

      /* -------------------------------------------------------------
         4. ANATOMÍA INTERNA Y BUCLE RESPIRATORIO
         ------------------------------------------------------------- */
      .flower-head-inner {
        transform-origin: 0px 0px;
        transition: transform 0.8s ease-out;
      }

      .open .flower-head-inner {
        animation: gentle-breath 5s ease-in-out infinite alternate 2.2s;
      }

      .sepal {
        transform-origin: 0px 0px;
        transform: rotate(var(--closed-rotate)) scale(var(--closed-scale-x), var(--closed-scale-y));
        opacity: var(--closed-opacity);
        transition: transform 1.8s cubic-bezier(0.34, 1.25, 0.64, 1) 1.2s, 
                    opacity 1.5s ease-in-out 1.2s;
      }

      .petal {
        transform-origin: 0px 0px;
        transform: rotate(var(--closed-rotate)) scale(var(--closed-scale-x), var(--closed-scale-y));
        opacity: var(--closed-opacity);
      }

      .center-core {
        transform-origin: 0px 0px;
        transform: scale(0);
        transition: transform 1.6s cubic-bezier(0.34, 1.3, 0.64, 1) 1.8s;
      }

      /* -------------------------------------------------------------
         5. BROTE ESCALONADO DE HOJAS
         ------------------------------------------------------------- */
      .leaf path {
        transform-origin: 0px 0px;
        transform: scale(0);
        transition: transform 1.5s cubic-bezier(0.34, 1.4, 0.64, 1);
      }

      /* Center Leaves */
      .open .center-group .leaf-l1 path, .open .center-group .leaf-r1 path { transform: scale(1); transition-delay: 0.8s; }
      .open .center-group .leaf-l2 path, .open .center-group .leaf-r2 path { transform: scale(1); transition-delay: 1.2s; }
      .open .center-group .leaf-l3 path, .open .center-group .leaf-r3 path { transform: scale(1); transition-delay: 1.6s; }

      /* Side Leaves */
      .open .left-group .leaf path { transform: scale(1); }
      .open .left-group .leaf-l1 path { transition-delay: 1.1s; }
      .open .left-group .leaf-l2 path { transition-delay: 1.5s; }

      .open .right-group .leaf path { transform: scale(1); }
      .open .right-group .leaf-r1 path { transition-delay: 1.3s; }
      .open .right-group .leaf-r2 path { transition-delay: 1.7s; }

      /* -------------------------------------------------------------
         6. APERTURA ESCALONADA DE PÉTALOS POR FLOR
         ------------------------------------------------------------- */
      
      /* Flor Central (Main) */
      .center-flower .petal-outer { transition: transform 1.6s cubic-bezier(0.34, 1.3, 0.64, 1) 1.2s, opacity 0.6s ease-in 1.3s; }
      .center-flower .petal-middle { transition: transform 1.5s cubic-bezier(0.34, 1.3, 0.64, 1) 1.4s, opacity 0.6s ease-in 1.5s; }
      .center-flower .petal-inner { transition: transform 1.4s cubic-bezier(0.34, 1.3, 0.64, 1) 1.6s, opacity 0.6s ease-in 1.7s; }
      .center-flower .petal-mini { transition: transform 1.3s cubic-bezier(0.34, 1.3, 0.64, 1) 1.8s, opacity 0.6s ease-in 1.9s; }
      .center-flower .petal-disc { transition: transform 1.2s cubic-bezier(0.34, 1.3, 0.64, 1) 2.0s, opacity 0.6s ease-in 2.1s; }

      /* Flor Izquierda */
      .left-flower .petal-outer { transition: transform 1.6s cubic-bezier(0.34, 1.3, 0.64, 1) 1.6s, opacity 0.6s ease-in 1.7s; }
      .left-flower .petal-middle { transition: transform 1.5s cubic-bezier(0.34, 1.3, 0.64, 1) 1.8s, opacity 0.6s ease-in 1.9s; }
      .left-flower .petal-inner { transition: transform 1.4s cubic-bezier(0.34, 1.3, 0.64, 1) 2.0s, opacity 0.6s ease-in 2.1s; }
      .left-flower .petal-mini { transition: transform 1.3s cubic-bezier(0.34, 1.3, 0.64, 1) 2.2s, opacity 0.6s ease-in 2.3s; }
      .left-flower .petal-disc { transition: transform 1.2s cubic-bezier(0.34, 1.3, 0.64, 1) 2.4s, opacity 0.6s ease-in 2.5s; }

      /* Flor Derecha */
      .right-flower .petal-outer { transition: transform 1.6s cubic-bezier(0.34, 1.3, 0.64, 1) 1.9s, opacity 0.6s ease-in 2.0s; }
      .right-flower .petal-middle { transition: transform 1.5s cubic-bezier(0.34, 1.3, 0.64, 1) 2.1s, opacity 0.6s ease-in 2.2s; }
      .right-flower .petal-inner { transition: transform 1.4s cubic-bezier(0.34, 1.3, 0.64, 1) 2.3s, opacity 0.6s ease-in 2.4s; }
      .right-flower .petal-mini { transition: transform 1.3s cubic-bezier(0.34, 1.3, 0.64, 1) 2.5s, opacity 0.6s ease-in 2.6s; }
      .right-flower .petal-disc { transition: transform 1.2s cubic-bezier(0.34, 1.3, 0.64, 1) 2.7s, opacity 0.6s ease-in 2.8s; }

      /* -------------------------------------------------------------
         7. COMPORTAMIENTO ABIERTO
         ------------------------------------------------------------- */
      .open .sepal {
        transform: rotate(calc(var(--target-rotate) * 1.3)) scale(calc(var(--target-scale) * 0.45)) translateY(120px);
        opacity: 0;
      }

      .open .petal {
        transform: rotate(var(--target-rotate)) scale(var(--target-scale));
        opacity: var(--target-opacity);
      }

      .open .center-core {
        transform: scale(1);
      }

      /* -------------------------------------------------------------
         8. MENSAJE EN LA PARTE INFERIOR
         ------------------------------------------------------------- */
      #love-message-card {
        transform: translate(-50%, 15px);
        opacity: 0;
        transition: opacity 1.4s ease-out, 
                    transform 1.4s cubic-bezier(0.25, 1, 0.5, 1);
        transition-delay: 0s;
      }

      #flower-interactive.open + #love-message-card {
        opacity: 1;
        transform: translate(-50%, 0);
        pointer-events: auto;
        transition-delay: 2.4s;
      }

      /* -------------------------------------------------------------
         9. OSCILACIÓN EN ASINCRONÍA DE LA HIERBA
         ------------------------------------------------------------- */
      .open .grass:nth-child(2n) { animation: grass-sway-left 6.0s ease-in-out infinite 2.8s; }
      .open .grass:nth-child(2n+1) { animation: grass-sway-right 7.0s ease-in-out infinite 2.8s; }

      /* Keyframes */
      @keyframes gentle-breath {
        0% { transform: scale(1) rotate(0deg); }
        100% { transform: scale(1.01) rotate(0.4deg); }
      }

      @keyframes light-pulse {
        0% { transform: scale(0.95); opacity: 0.7; }
        100% { transform: scale(1.05); opacity: 1; }
      }

      @keyframes float-slow {
        0% { transform: translateY(0) translateX(0) scale(1); }
        50% { transform: translateY(-40px) translateX(30px) scale(1.1); }
        100% { transform: translateY(20px) translateX(-20px) scale(0.95); }
      }

      /* Sway anims: Tallo (Group) e inclinación contraria (Head) */
      @keyframes group-sway-center {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(-1.4deg); }
        75% { transform: rotate(1.4deg); }
        100% { transform: rotate(0deg); }
      }
      @keyframes head-nod-center {
        0% { transform: translate(400px, 300px) scale(1) rotate(0deg); }
        25% { transform: translate(400px, 300px) scale(1) rotate(2deg); }
        75% { transform: translate(400px, 300px) scale(1) rotate(-2deg); }
        100% { transform: translate(400px, 300px) scale(1) rotate(0deg); }
      }

      @keyframes group-sway-left {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(-1.8deg); }
        75% { transform: rotate(1.0deg); }
        100% { transform: rotate(0deg); }
      }
      @keyframes head-nod-left {
        0% { transform: translate(250px, 420px) scale(0.75) rotate(-25deg); }
        25% { transform: translate(250px, 420px) scale(0.75) rotate(-22deg); }
        75% { transform: translate(250px, 420px) scale(0.75) rotate(-28deg); }
        100% { transform: translate(250px, 420px) scale(0.75) rotate(-25deg); }
      }

      @keyframes group-sway-right {
        0% { transform: rotate(0deg); }
        25% { transform: rotate(-0.8deg); }
        75% { transform: rotate(1.8deg); }
        100% { transform: rotate(0deg); }
      }
      @keyframes head-nod-right {
        0% { transform: translate(550px, 450px) scale(0.7) rotate(20deg); }
        25% { transform: translate(550px, 450px) scale(0.7) rotate(23deg); }
        75% { transform: translate(550px, 450px) scale(0.7) rotate(17deg); }
        100% { transform: translate(550px, 450px) scale(0.7) rotate(20deg); }
      }

      @keyframes grass-sway-left {
        0% { transform: scaleY(1) rotate(0deg); }
        25% { transform: scaleY(1) rotate(-2deg); }
        75% { transform: scaleY(1) rotate(1.5deg); }
        100% { transform: scaleY(1) rotate(0deg); }
      }
      @keyframes grass-sway-right {
        0% { transform: scaleY(1) rotate(0deg); }
        25% { transform: scaleY(1) rotate(-1deg); }
        75% { transform: scaleY(1) rotate(2.5deg); }
        100% { transform: scaleY(1) rotate(0deg); }
      }
    </style>
  </head>
  <body class="w-screen h-dvh overflow-hidden bg-[radial-gradient(circle_at_center,#080612_0%,#030206_100%)] text-[#f3f3f6] font-sans flex justify-center items-center select-none">
    
    <!-- Glowing Background Bokeh Lights -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div class="bokeh-light light-1"></div>
      <div class="bokeh-light light-2"></div>
      <div class="bokeh-light light-3"></div>
      <div class="bokeh-light light-4"></div>
    </div>

    <!-- Soft ambient light behind the garden -->
    <div class="absolute w-[50%] h-[50%] bg-[radial-gradient(circle,rgba(255,255,255,0.04)_0%,transparent_75%)] rounded-full pointer-events-none z-0 animate-[light-pulse_6s_ease-in-out_infinite_alternate]"></div>

    <div class="relative w-full max-w-[620px] h-full max-h-[820px] flex flex-col justify-center items-center p-6 z-10">
      
      <!-- Click Hint Instruction -->
      <span class="absolute top-[12%] text-white/30 text-xs tracking-[0.2em] uppercase transition-opacity duration-700 ease-out pointer-events-none animate-pulse" id="hint">
        Haz clic en las flores para verlas crecer y florecer
      </span>

      <!-- Interactive Flower Container -->
      <div class="relative w-full aspect-square flex justify-center items-center cursor-pointer" id="flower-interactive">
        <svg class="w-full h-full filter drop-shadow-[0_15px_30px_rgba(0,0,0,0.65)]" viewBox="0 0 800 800" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <!-- Petal Shader: Cream and pure white for natural white Gerbera petals -->
            <linearGradient id="petal-grad" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#ded9ca" />
              <stop offset="22%" stop-color="#faf8f3" />
              <stop offset="100%" stop-color="#ffffff" />
            </linearGradient>

            <!-- Sepal Shader: Green gradients for outer closed bud shell -->
            <linearGradient id="sepal-grad" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#122a18" />
              <stop offset="45%" stop-color="#265231" />
              <stop offset="85%" stop-color="#3d824d" />
              <stop offset="100%" stop-color="#56ad6b" />
            </linearGradient>

            <!-- Stem Shader: Organic green gradient -->
            <linearGradient id="stem-grad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#2c531d" />
              <stop offset="50%" stop-color="#3d752a" />
              <stop offset="100%" stop-color="#1b3511" />
            </linearGradient>

            <!-- Leaf Shader: Semi-translucent glowing turquoise -->
            <linearGradient id="leaf-grad" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#051c1c" stop-opacity="0.8" />
              <stop offset="70%" stop-color="#0f4a4a" stop-opacity="0.85" />
              <stop offset="100%" stop-color="#14ab9e" stop-opacity="0.9" />
            </linearGradient>

            <!-- Grass Shader: Deep forest teal to green grass blade -->
            <linearGradient id="grass-grad" x1="0%" y1="100%" x2="0%" y2="0%">
              <stop offset="0%" stop-color="#030c08" />
              <stop offset="60%" stop-color="#0c2e23" />
              <stop offset="100%" stop-color="#1b5a45" />
            </linearGradient>

            <!-- Flower Center Shader: Dark core with magical golden/amber pollen ring -->
            <radialGradient id="center-grad" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#0a0502" />
              <stop offset="35%" stop-color="#140b04" />
              <stop offset="65%" stop-color="#3b2308" />
              <stop offset="85%" stop-color="#ffca28" />
              <stop offset="93%" stop-color="#ffa000" />
              <stop offset="100%" stop-color="#123d42" />
            </radialGradient>

            <!-- Single highly optimized magical glow filter for the entire flower head group -->
            <filter id="petal-shadow" x="-20%" y="-20%" width="140%" height="140%">
              <feDropShadow dx="0" dy="3" stdDeviation="4" flood-color="#00bcd4" flood-opacity="0.2" />
