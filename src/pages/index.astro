    <!-- Client-side Interactions -->
    <script>
      let backgroundIntervals = [];

      // Dandelion seed SVG generator
      const createSeed = () => {
        const container = document.getElementById('particles-container');
        if (!container) return;

        const seed = document.createElement('div');
        seed.style.position = 'absolute';
        
        const startX = Math.random() * window.innerWidth;
        const startY = window.innerHeight + 30;
        const size = Math.random() * 8 + 6;
        
        seed.style.left = `${startX}px`;
        seed.style.top = `${startY}px`;
        seed.style.width = `${size}px`;
        seed.style.height = `${size * 2.5}px`;
        seed.style.pointerEvents = 'none';
        seed.style.willChange = 'transform, opacity';
        
        seed.innerHTML = `
          <svg viewBox="0 0 10 25" class="w-full h-full opacity-50 text-white/70 fill-current">
            <line x1="5" y1="20" x2="5" y2="5" stroke="currentColor" stroke-width="0.8" />
            <path d="M 5 5 L 2 1 M 5 5 L 8 1 M 5 5 L 1 3 M 5 5 L 9 3 M 5 5 L 5 0" stroke="currentColor" stroke-width="0.6" />
            <circle cx="5" cy="20" r="1.2" fill="currentColor" />
          </svg>
        `;
        
        container.appendChild(seed);
        
        const endX = startX + (Math.random() - 0.4) * 350 - 100;
        const endY = -50;
        const duration = 12000 + Math.random() * 8000;
        const rot = (Math.random() - 0.5) * 60;
        
        const anim = seed.animate([
          { transform: 'translate(0, 0) rotate(0deg)', opacity: 0 },
          { transform: 'translate(0, 0) rotate(0deg)', opacity: 0.7, offset: 0.1 },
          { transform: `translate(${endX - startX}px, ${endY - startY}px) rotate(${rot}deg)`, opacity: 0 }
        ], {
          duration: duration,
          easing: 'linear'
        });
        
        anim.onfinish = () => seed.remove();
      };

      const createSeedAtHeight = () => {
        const container = document.getElementById('particles-container');
        if (!container) return;

        const seed = document.createElement('div');
        seed.style.position = 'absolute';
        
        const startX = Math.random() * window.innerWidth;
        const startY = Math.random() * (window.innerHeight - 100);
        const size = Math.random() * 8 + 6;
        
        seed.style.left = `${startX}px`;
        seed.style.top = `${startY}px`;
        seed.style.width = `${size}px`;
        seed.style.height = `${size * 2.5}px`;
        seed.style.pointerEvents = 'none';
        seed.style.willChange = 'transform, opacity';
        
        seed.innerHTML = `
          <svg viewBox="0 0 10 25" class="w-full h-full opacity-50 text-white/70 fill-current">
            <line x1="5" y1="20" x2="5" y2="5" stroke="currentColor" stroke-width="0.8" />
            <path d="M 5 5 L 2 1 M 5 5 L 8 1 M 5 5 L 1 3 M 5 5 L 9 3 M 5 5 L 5 0" stroke="currentColor" stroke-width="0.6" />
            <circle cx="5" cy="20" r="1.2" fill="currentColor" />
          </svg>
        `;
        
        container.appendChild(seed);
        
        const endX = startX + (Math.random() - 0.4) * 350 - 100;
        const endY = -50;
        const remainingYRatio = startY / window.innerHeight;
        const duration = (12000 + Math.random() * 8000) * remainingYRatio;
        const rot = (Math.random() - 0.5) * 60;
        
        const anim = seed.animate([
          { transform: 'translate(0, 0) rotate(0deg)', opacity: 0.6 },
          { transform: `translate(${endX - startX}px, ${endY - startY}px) rotate(${rot}deg)`, opacity: 0 }
        ], {
          duration: duration,
          easing: 'linear'
        });
        
        anim.onfinish = () => seed.remove();
      };

      // Firefly generator
      const createFirefly = () => {
        const container = document.getElementById('particles-container');
        if (!container) return;

        const f = document.createElement('div');
        const size = Math.random() * 5 + 3.5;
        const color = '#ffd54f';
        
        f.style.position = 'absolute';
        f.style.width = `${size}px`;
        f.style.height = `${size}px`;
        f.style.backgroundColor = color;
        f.style.borderRadius = '50%';
        f.style.boxShadow = `0 0 ${size * 2.5}px ${color}, 0 0 ${size * 0.8}px #fff`;
        
        const startX = Math.random() * window.innerWidth;
        const startY = window.innerHeight + 30;
        f.style.left = `${startX}px`;
        f.style.top = `${startY}px`;
        f.style.pointerEvents = 'none';
        f.style.willChange = 'transform, opacity';
        
        container.appendChild(f);
        
        const endX = startX + (Math.random() - 0.5) * 250;
        const endY = -50;
        const duration = 9000 + Math.random() * 5005;
        
        const anim = f.animate([
          { transform: 'translate(0, 0) scale(1)', opacity: 0 },
          { opacity: 0.8, offset: 0.15 },
          { opacity: 0.35, offset: 0.5 },
          { opacity: 0.9, offset: 0.8 },
          { transform: `translate(${endX - startX}px, ${endY - startY}px) scale(0.6)`, opacity: 0 }
        ], {
          duration: duration,
          easing: 'ease-in-out'
        });
        
        anim.onfinish = () => f.remove();
      };

      const createFireflyAtHeight = () => {
        const container = document.getElementById('particles-container');
        if (!container) return;

        const f = document.createElement('div');
        const size = Math.random() * 5 + 3.5;
        const color = '#ffd54f';
        
        f.style.position = 'absolute';
        f.style.width = `${size}px`;
        f.style.height = `${size}px`;
