        f.style.boxShadow = `0 0 ${size * 2.5}px ${color}, 0 0 ${size * 0.8}px #fff`;
        
        const startX = Math.random() * window.innerWidth;
        const startY = Math.random() * (window.innerHeight - 100);
        f.style.left = `${startX}px`;
        f.style.top = `${startY}px`;
        f.style.pointerEvents = 'none';
        f.style.willChange = 'transform, opacity';
        
        container.appendChild(f);
        
        const endX = startX + (Math.random() - 0.5) * 250;
        const endY = -50;
        const remainingYRatio = startY / window.innerHeight;
        const duration = (9000 + Math.random() * 5005) * remainingYRatio;
        
        const anim = f.animate([
